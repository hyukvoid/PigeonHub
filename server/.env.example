# Copy to .env (gitignored) and fill in.

# Port for the local dev sender.
PORT=8787

# Device FCM registration token. Get it from the PigeonHub app:
#   Device tab -> "Check FCM registration" -> "Copy token"
# (only available after Firebase is configured on the Android side,
#  see docs/FIREBASE_SETUP.md)
FCM_DEVICE_TOKEN=

# Path to the Firebase service account JSON for project <your-pigeonhub-project>.
# NEVER commit this file. Create it in:
#   Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=

# Optional: when set, /push requires `Authorization: Bearer <PUSH_AUTH_TOKEN>`.
PUSH_AUTH_TOKEN=
