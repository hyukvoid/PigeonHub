    <string name="onboarding_invite_why_body">모든 기기는 자신만의 프라이빗 푸시 채널을 만들어요. 프라이빗 베타 동안 일회용 초대 코드가 그 채널을 본인 것으로 유지하고 공개 스팸을 차단해요.</string>
    <string name="onboarding_invite_where_title">초대 코드는 어디서 받나요?</string>
    <string name="onboarding_invite_where_body">초대 코드는 PigeonHub 관리자가 배포합니다.</string>
    <string name="onboarding_permission_title">알림 허용</string>
    <string name="onboarding_permission_body">작업이 끝나면 PigeonHub가 즉시 알림으로 알려드려요. Android에서 권한이 필요해요.</string>
    <string name="onboarding_permission_allow">알림 허용</string>
    <string name="onboarding_permission_skip">나중에</string>
